        "Q10M13": { "correctOption": "D", "explanation": "Arithmetic Mean is a measure of central tendency, not dispersion." },
        "Q10M14": { "correctOption": "A", "explanation": "P(A ∪ B) = P(A) + P(B) - P(A ∩ B) = 0.37 + 0.42 - 0.09 = 0.70." }
